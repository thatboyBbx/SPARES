# Copy to .env and adjust for your local setup.
# Docker Compose injects these directly, so .env is only needed when
# running the API outside of Docker (e.g. `uvicorn app.main:app --reload`
# on the host).

APP_NAME=SPOP API
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://spop:spop@localhost:5432/spop
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

ALLOWED_ORIGINS=["http://localhost:5173"]
